{
	"name": "nimcharts-charting-library",
	"version": "1.0.0",
	"description": "A high-performance modular charting library built in TypeScript for TYCS Sem 5",
	"type": "module",
	"main": "./dist/tycs-charts.umd.js",
	"module": "./dist/tycs-charts.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/tycs-charts.js",
			"require": "./dist/tycs-charts.umd.js",
			"types": "./dist/tycs-charts.d.ts"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/"
	},
	"keywords": [
		"chart",
		"canvas",
		"typescript",
		"library",
		"tycs"
	],
	"author": "Nimish Rajwade",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@microsoft/api-extractor": "^7.60.0",
		"@types/node": "^26.6.5",
		"typescript": "^6.0.3",
		"unplugin-dts": "^1.1.2",
		"vite": "^8.3.4"
	}
}
